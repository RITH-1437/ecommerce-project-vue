{
  "info": {
    "name": "Ecommerce Project Full Test Suite",
    "_postman_id": "ecommerce-project-tests-001",
    "description": "Complete test suite for authentication, products, orders, vouchers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"john_test\",\n  \"email\": \"john@example.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Get Me (Authenticated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/users/me"
          }
        }
      ]
    },

    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15\",\n  \"price\": 1200,\n  \"stock\": 20,\n  \"category\": \"IPHONE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/admin/products"
          }
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/products"
          }
        },
        {
          "name": "Update Product (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15 Pro\",\n  \"price\": 1300,\n  \"stock\": 15\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/admin/products/1"
          }
        },
        {
          "name": "Delete Product (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/admin/products/1"
          }
        }
      ]
    },

    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"products\": [\n    {\"productId\": 1, \"qty\": 2}\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/orders"
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/orders/my"
          }
        }
      ]
    },

    {
      "name": "Voucher (Admin CRUD)",
      "item": [
        {
          "name": "Create Voucher",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"APPLE2025\",\n  \"discountType\": \"PERCENT\",\n  \"value\": 10,\n  \"minSpend\": 50,\n  \"stackable\": false,\n  \"priority\": 1,\n  \"userLimit\": 1,\n  \"globalLimit\": 100,\n  \"note\": \"10% off all iPhones\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/admin/vouchers"
          }
        },
        {
          "name": "Update Voucher",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 15,\n  \"status\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/admin/vouchers/1"
          }
        },
        {
          "name": "Delete Voucher",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/admin/vouchers/1"
          }
        }
      ]
    },

    {
      "name": "Apply Voucher (User)",
      "item": [
        {
          "name": "Apply Voucher APPLE2025",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cartTotal\": 200,\n  \"cartCategories\": [\"IPHONE\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/vouchers/apply/APPLE2025"
          }
        }
      ]
    },

    {
      "name": "Voucher Usage (Admin)",
      "item": [
        {
          "name": "Get All Voucher Usage",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/admin/vouchers/usage"
          }
        },
        {
          "name": "Get Usage by User ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/admin/vouchers/usage/user/1"
          }
        }
      ]
    }

  ]
}
