# Environment Variables for Local Development
# Copy this file to .env or set these environment variables

# Database Configuration
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ABA PayWay Configuration
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_SECRET_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Instructions:
# 1. Set these environment variables in your system OR
# 2. Copy this file to .env and use a library like spring-boot-dotenv OR
# 3. Set them in your IDE's run configuration OR
# 4. Set them in application-local.properties (which should be in .gitignore)

# For PowerShell (Windows):
# $env:DB_PASSWORD="your_mysql_password_here"
# $env:GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
# etc...

# For Bash (Linux/Mac):
# export DB_PASSWORD="your_mysql_password_here"
# export GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
# etc...
