# Google OAuth Configuration
# Set VITE_GOOGLE_OAUTH_ENABLED=true and provide real Client ID to enable Google Sign-In
# To get Google Client ID: Follow the guide in document/GOOGLE_OAUTH_SETUP.md
VITE_GOOGLE_OAUTH_ENABLED=false
VITE_GOOGLE_CLIENT_ID=

# Application Settings
VITE_APP_NAME=Apple Store
VITE_APP_URL=http://localhost:5173

# Development Settings
VITE_DEBUG_MODE=true